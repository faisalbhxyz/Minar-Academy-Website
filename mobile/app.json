{
  "expo": {
    "name": "Minar Academy",
    "slug": "minar-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "minaracademy",
    "notification": {
      "icon": "./assets/android-icon-monochrome.png",
      "color": "#246962"
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f7f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minaracademy.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "প্রোফাইল ছবি আপডেট করতে গ্যালারি অ্যাক্সেস প্রয়োজন।",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.minaracademy.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "লগইন সেশন সুরক্ষিত রাখতে Face ID ব্যবহার করা যেতে পারে।"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "প্রোফাইল ছবি আপডেট করতে গ্যালারি অ্যাক্সেস প্রয়োজন।"
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "networkInspector": false
          },
          "ios": {
            "networkInspector": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#246962",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48e50cf7-49a9-4729-af2f-21f156abb82b"
      }
    },
    "owner": "faisalbh"
  }
}
